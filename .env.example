# Copy this file to .env and replace every placeholder.
PORT=3000
NODE_ENV=development
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d
DB_PATH=./data/family-track.db

# Comma-separated allowed origins. For a native Android app, this can remain *.
# For a browser dashboard, replace * with its exact HTTPS origin.
CORS_ORIGINS=*
